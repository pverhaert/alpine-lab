{
  "name": "alpine-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive live coding playground for Alpine.js with Tailwind CSS v4 support, Monaco editor, snippets library, and PWA capabilities.",
  "homepage": "https://alpine-lab.netlify.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/pverhaert/alpine-lab.git"
  },
  "bugs": {
    "url": "https://github.com/pverhaert/alpine-lab/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=6987 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:unused": "knip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "emmet": "^2.4.11",
    "emmet-monaco-es": "^5.7.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.14.0",
    "knip": "^6.36.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
